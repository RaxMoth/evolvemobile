class_name UiPalette
extends Resource

## The one colour source of the Jungle Guild look: UnderGuild's collection
## screen (warm charcoal, thick dark-brown ink, copper outlines, bold off-white
## text with an ink outline, red "upgrade ready" pills) grown into a jungle
## (carved wood and mossy stone plaques, moss and teal, amber highlights). The
## hero side reads warm (copper, amber, moss), the monster side dangerous
## (crimson, purple).
##
## The values live in palette.tres (get_default()). tools/art/make_theme.py
## writes it, and the token block below, from tools/art/palette.py: change a
## colour there and rerun `python3 tools/art/make_theme.py palette`, never here.
##
## Consumers:
##   - Controls: the theme (built from the same palette.py).
##   - Scripts that draw (_draw, shader uniforms, modulates):
##     UiPalette.get_default().<token>.
##   - Data that names a colour: a StringName token resolved with color(token).

const DEFAULT_PATH := "res://Scenes/UI/Theme/palette.tres"
## Alpha of cooldown_veil over a cooling ability icon.
const COOLDOWN_VEIL_ALPHA := 0.70
## self_modulate of a locked character portrait (near-black silhouette).
const LOCKED_MODULATE := Color(0.16, 0.145, 0.14, 1.0)
## modulate of the lobby stage whose side is not chosen (dimmed, a touch warm).
const UNCHOSEN_SIDE_MODULATE := Color(0.5, 0.47, 0.47, 1.0)
## modulate of a menu screen while the next one slides over it (MenuRoot).
const COVERED_SCREEN_MODULATE := Color(0.6, 0.6, 0.6, 1.0)
## Character id -> its signature token (signature()). nyxa and gorrak use the
## provisional monster2 / monster3 colours until the monster roster is final.
const SIGNATURE_TOKENS: Dictionary[String, StringName] = {
	"irelia": &"irelia",
	"vlad": &"vlad",
	"ted": &"ted",
	"river": &"river",
	"grount": &"grount",
	"nyxa": &"monster2",
	"gorrak": &"monster3",
}

static var _default: UiPalette = null

