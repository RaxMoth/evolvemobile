## The project palette (palette.tres), loaded once.
static func get_default() -> UiPalette:
	if _default == null:
		_default = load(DEFAULT_PATH) as UiPalette
	return _default


## Signature colour of a hero or monster id ("irelia", "grount", ...). Any
## other id falls back to its side's accent.
static func signature(id: String, is_monster: bool) -> Color:
	var token: StringName = SIGNATURE_TOKENS.get(id, &"monster" if is_monster else &"hero")
	return get_default().color(token)


## Data-side lookup by token name. An unknown token is a content bug, so it
## comes back magenta and cannot hide.
func color(token: StringName) -> Color:
	var value: Variant = get(token)
	if value is Color:
		return value
	return Color.MAGENTA


## Every token name (the exported Color properties), in palette order.
func tokens() -> Array[StringName]:
	var out: Array[StringName] = []
	for prop: Dictionary in get_property_list():
		if prop.type == TYPE_COLOR and (prop.usage & PROPERTY_USAGE_STORAGE):
			out.append(StringName(prop.name))
	return out
